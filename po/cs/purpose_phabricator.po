#, kde-format
msgid "Could not get list of differential revisions in %1"
msgstr "Nepodařilo se načíst seznam rozdílových revizí v %1"

#: phabricatorplugin.cpp:49
#, kde-format
msgid "Phabricator refuses empty patchfiles"
msgstr "Phabricator nepřijímá prázdné soubory se záplatami"

#: phabricatorplugin.cpp:54 phabricatorplugin_config.qml:55
#, kde-format
msgid "unknown"
msgstr "neznámý"

#: phabricatorplugin.cpp:56
#, kde-format
msgid ""
"Please choose between creating a new revision or updating an existing one"
msgstr ""
"Vyberte si, zda chcete vytvořit novou revizi, nebo aktualizovat stávající"

#: phabricatorplugin_config.qml:28
#, kde-format
msgid "Update differential revision %1"
msgstr "Aktualizace rozdílové revize %1"

#: phabricatorplugin_config.qml:28
#, kde-format
msgid "Update differential revision"
msgstr "Aktualizace rozdílové revize"

#: phabricatorplugin_config.qml:30
#, kde-format
msgid "Create new \"differential diff\""
msgstr "Vytvořit nový \"rozdílový diff\""

#: phabricatorplugin_config.qml:32
#, kde-format
msgid "Create or update?"
msgstr "Vytvořit nebo aktualizovat?"

#: phabricatorplugin_config.qml:65
#, kde-format
msgid "New Diff"
msgstr "Nový rozdílový soubor"

#: phabricatorplugin_config.qml:66
#, kde-format
msgid ""
"tick this to create a new \"differential diff\" which can\n"
"be converted online to a new differential revision"
msgstr ""
"zaškrtněte toto políčko, chcete-li vytvořit nový \"rozdílový diff\",\n"
"který lze online převést na novou rozdílovou revizi"

#: phabricatorplugin_config.qml:73
#, kde-format
msgid "Update Diff"
msgstr "Aktualizovat rozdíl"

#: phabricatorplugin_config.qml:74
#, kde-format
msgid ""
"tick this to update an existing revision,\n"
"select one from the list below."
msgstr ""
"zaškrtněte toto políčko, chcete-li aktualizovat stávající revizi,\n"
"vyberte jednu z níže uvedeného seznamu."

#: phabricatorplugin_config.qml:102
#, kde-format
msgid "Open Diff in browser"
msgstr "Otevřít rozdílový soubor v prohlížeči"

